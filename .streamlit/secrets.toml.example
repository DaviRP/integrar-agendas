APP_PASSWORD = "escolha-uma-senha-forte-aqui"

# Empresas fixas (persistem entre reinícios e computadores). Uma seção por empresa;
# o nome depois de "empresas." é só um identificador (sem espaços/acentos).
# A aba "Empresas" do app gera esse bloco pronto para empresas cadastradas pela tela.
[empresas.exemplo]
nome = "Clínica Exemplo"
client_id = "seu-client-id"
client_secret = "seu-client-secret"
cid = "token-clinicaNasNuvens-cid"
id_local_agenda = 0
id_tipo_consulta = 0
id_tipo_convenio = 0
status_agendamento = "AGENDADO"
duracao_padrao_minutos = 30
data_nascimento_padrao = "2000-01-01"
